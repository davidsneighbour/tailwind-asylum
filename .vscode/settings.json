{
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock, .editorconfig, .release-it.ts, .gitignore",
    "README.md": "CHANGELOG.md, LICENSE.md",
    "AGENTS.md": "CLAUDE.md",
    "astro.config.ts": ".editorconfig"
  }
}
