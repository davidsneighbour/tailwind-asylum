---
import { SITE_DESCRIPTION, SITE_TITLE } from "@config/setup";
import Layout from "@layouts/Layout.astro";
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section>
		<p class="mb-3 text-xs font-semibold tracking-wide text-accent uppercase">Tailwind CSS sandbox</p>
		<h1 class="font-display max-w-[14ch] text-4xl font-semibold sm:text-5xl">
			A runnable playground for Tailwind CSS work.
		</h1>
		<p class="mt-6 max-w-prose text-lg text-neutral-600 dark:text-neutral-300">
			{SITE_DESCRIPTION} It is boilerplate, not a product &mdash; each case in the blog section is a
			self-contained, editable Tailwind example.
		</p>
		<div class="mt-8 flex flex-wrap items-center gap-6">
			<a
				href="/asylum/"
				class="inline-flex min-h-11 items-center justify-center border border-accent bg-accent px-4 font-semibold text-white transition hover:opacity-90"
			>
				Browse the blog
			</a>
			<a href="/about/" class="font-semibold text-neutral-700 hover:text-accent dark:text-neutral-200">
				About this repo
			</a>
		</div>
	</section>
</Layout>
