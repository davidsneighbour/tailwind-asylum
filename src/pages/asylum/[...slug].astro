---
import { Image } from "astro:assets";
import { type CollectionEntry, getCollection, render } from "astro:content";
import FormattedDate from "@components/FormattedDate.astro";
import Layout from "@layouts/Layout.astro";
import { normalizeBlogId } from "@utils/blog";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: normalizeBlogId(post.id) },
    props: post,
  }));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { title, description, pubDate, updatedDate, heroImage } = post.data;
const { Content } = await render(post);
---

<Layout title={title} description={description} image={heroImage}>
	<article>
		{heroImage && <Image width={1020} height={510} src={heroImage} alt="" class="mb-8 w-full border border-neutral-200 dark:border-neutral-800" />}
		<p class="font-mono text-xs text-accent">
			<FormattedDate date={pubDate} />
			{updatedDate && (
				<span class="ml-2 text-neutral-500 dark:text-neutral-400">
					(updated <FormattedDate date={updatedDate} />)
				</span>
			)}
		</p>
		<h1 class="font-display mt-2 mb-8 text-3xl font-semibold sm:text-4xl">{title}</h1>
		<div class="prose dark:prose-invert max-w-none">
			<Content />
		</div>
	</article>
</Layout>
