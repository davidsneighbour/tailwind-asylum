---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import FormattedDate from "@components/FormattedDate.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "@config/setup";
import Layout from "@layouts/Layout.astro";
import { normalizeBlogId } from "@utils/blog";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title={`Blog — ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
	<p class="mb-3 text-xs font-semibold tracking-wide text-accent uppercase">Blog</p>
	<h1 class="font-display mb-8 text-3xl font-semibold sm:text-4xl">Cases &amp; playgrounds.</h1>

	<ul class="divide-y divide-neutral-200 border-t border-neutral-200 dark:divide-neutral-800 dark:border-neutral-800">
		{
			posts.map((post) => (
				<li class="py-6">
					<a href={`/asylum/${normalizeBlogId(post.id)}/`} class="group flex gap-6">
						{post.data.heroImage && (
							<Image
								width={160}
								height={110}
								src={post.data.heroImage}
								alt=""
								class="hidden h-27.5 w-40 shrink-0 border border-neutral-200 object-cover sm:block dark:border-neutral-800"
							/>
						)}
						<div>
							<p class="font-mono text-xs text-accent">
								<FormattedDate date={post.data.pubDate} />
							</p>
							<h2 class="font-display mt-1 text-xl font-semibold group-hover:text-accent">
								{post.data.title}
							</h2>
							<p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">{post.data.description}</p>
						</div>
					</a>
				</li>
			))
		}
	</ul>
</Layout>
