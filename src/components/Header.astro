---
import HeaderLink from "@components/HeaderLink.astro";
import { NAV_ITEMS, SITE_TITLE } from "@config/setup";
---

<header
	class="sticky top-0 z-10 border-b border-neutral-200 bg-white/90 backdrop-blur dark:border-neutral-800 dark:bg-neutral-950/90"
>
	<div class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8">
		<a href="/" class="font-display flex items-center gap-2 text-lg font-semibold">
			<span class="border-x border-accent" aria-hidden="true" style="width: 0.6rem; height: 1.1rem;"></span>
			{SITE_TITLE}
		</a>
		<nav aria-label="Main navigation" class="flex items-center gap-4 text-sm sm:gap-6">
			{
				NAV_ITEMS.map((item) => (
					<HeaderLink href={item.href} class="text-neutral-600 hover:text-accent dark:text-neutral-300">
						{item.label}
					</HeaderLink>
				))
			}
			<button
				type="button"
				id="theme-toggle"
				aria-label="Toggle color theme"
				class="grid size-8 shrink-0 place-items-center rounded-full border border-neutral-300 text-neutral-600 transition hover:border-accent hover:text-accent dark:border-neutral-700 dark:text-neutral-300"
			>
				<span aria-hidden="true" class="size-3 rounded-full border border-current bg-[linear-gradient(90deg,currentColor_50%,transparent_50%)]"
				></span>
			</button>
		</nav>
	</div>
</header>

<script>
	const toggle = document.getElementById('theme-toggle');
	toggle?.addEventListener('click', () => {
		const root = document.documentElement;
		const next = root.classList.contains('dark') ? 'light' : 'dark';
		root.classList.toggle('dark', next === 'dark');
		localStorage.setItem('theme', next);
	});
</script>
